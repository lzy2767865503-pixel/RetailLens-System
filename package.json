{
  "name": "retaillens-system",
  "private": true,
  "version": "1.1.0",
  "description": "Bilingual, evidence-led retail business assessment and consulting workpaper system.",
  "author": {
    "name": "LAI ZEYU（来泽宇）",
    "url": "https://github.com/lzy2767865503-pixel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzy2767865503-pixel/RetailLens-System.git"
  },
  "homepage": "https://github.com/lzy2767865503-pixel/RetailLens-System#readme",
  "bugs": {
    "url": "https://github.com/lzy2767865503-pixel/RetailLens-System/issues"
  },
  "keywords": [
    "retail",
    "business-analysis",
    "strategy",
    "bilingual",
    "consulting",
    "openai"
  ],
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c blue,green \"vite --host 127.0.0.1\" \"tsx watch server/cli.ts\"",
    "build": "tsc --noEmit && vite build && pnpm build:electron-main",
    "build:electron-main": "node scripts/build-electron.mjs",
    "start": "cross-env NODE_ENV=production tsx server/cli.ts",
    "desktop": "pnpm build && electron .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "pnpm build && playwright test --config playwright.desktop.config.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:all": "pnpm audit --audit-level high",
    "metadata:notices": "node scripts/generate-third-party-notices.mjs",
    "metadata:notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "metadata:attribution": "node scripts/verify-attribution.mjs",
    "metadata:sbom": "node scripts/generate-sbom.mjs",
    "package:windows": "pnpm metadata:attribution && pnpm build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "package:store": "node scripts/validate-store-env.mjs && node scripts/validate-certification-gates.mjs && pnpm metadata:attribution && pnpm build && electron-builder --config electron-builder.config.cjs --win appx --x64 --publish never"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "lucide-react": "1.27.0",
    "openai": "6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
